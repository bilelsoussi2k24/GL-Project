# Copy to backend/.env and fill in. Never commit the real file.
# The database and schema are created automatically on first start.

# MySQL connection
DB_URL=jdbc:mysql://localhost:3306/hospital_db
DB_USER=root
DB_PASSWORD=

# HTTP server
BIND_ADDRESS=127.0.0.1
PORT=8080

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Staff session lifetime, in hours
SESSION_HOURS=12

# First administrator, created only when the database has no admin yet.
# If ADMIN_PASSWORD is empty a random password is printed once at first start.
ADMIN_EMAIL=admin@haven.local
ADMIN_PASSWORD=

# Python AI service used by the public assistant (optional)
AI_SERVICE_URL=http://127.0.0.1:8000/api/chat
AI_TIMEOUT_SECONDS=25

# Apply the additive schema migration on start
AUTO_MIGRATE=true
