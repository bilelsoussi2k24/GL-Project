# Copy to backend_ai/.env and fill in. Never commit the real file.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for chat answers.
GEMINI_MODEL=gemini-2.5-flash

# Request timeout in milliseconds.
GEMINI_TIMEOUT_MS=20000

# Browser origins allowed to call this service directly (the Java API usually calls it server-side).
AI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional, only for the experimental Pinecone knowledge-base scripts.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hospital-embeddings
